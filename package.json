{
  "name": "kairon",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-continuation-lessons.mjs && node scripts/build-progress-index.mjs && prisma generate && next build && node scripts/check-client-content.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node scripts/build-continuation-lessons.mjs --check && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "env:init": "node scripts/init-env.mjs",
    "db:provision": "tsx scripts/provision-runtime.ts",
    "db:check": "tsx scripts/check-db.ts",
    "account": "tsx scripts/account.ts",
    "test:e2e": "playwright test",
    "test:accounts": "node scripts/check-accounts.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.3.1",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "smtp-server": "^3.21.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
