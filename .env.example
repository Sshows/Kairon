# Runtime: отдельная роль kairon_runtime, не владелец и без BYPASSRLS.
DATABASE_URL=
# Только миграции/админский CLI. Не добавлять в Vercel runtime.
DIRECT_URL=
# Случайная строка не короче 32 символов. npm run env:init создаёт локальный секрет.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST задавать только как true за доверенным proxy при необходимости.
# На Vercel Auth.js определяет хост сам.
# Redis потребуется на этапе очередей лабораторий; на этапе 0 не используется.
REDIS_URL=
# На этапе 0 службы лабораторий и ИИ ещё не подключены.
LAB_ORCHESTRATOR_URL=
OLLAMA_BASE_URL=
